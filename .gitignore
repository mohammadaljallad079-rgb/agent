# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# uv resolves from pyproject.toml (CI installs with `uv pip install -e .[dev]`),
# so the environment lockfile is a local artifact, not tracked.
uv.lock

# Runtime data (local/offline store, workspaces, logs)
.agent-data/
*.log

# Redis persistence artifact (created by a local redis-server run)
dump.rdb

# Local model weights — never commit (large binaries)
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt

# Secrets — never commit
*.pem
*.key
credentials.json
