# Arabic AI Agent Platform — environment template.
# Copy to .env and fill in. NEVER commit a filled-in .env.

# --- Environment ---
AAP_ENVIRONMENT=dev
AAP_RUNTIME_KIND=cloud
AAP_DEFAULT_LOCALE=ar

# --- HTTP ---
AAP_HOST=0.0.0.0
AAP_PORT=8000
AAP_CORS_ORIGINS=

# --- Model gateway (choose at least one) ---
# Cloud:
AAP_OPENAI_API_KEY=
AAP_DEFAULT_MODEL=openai/gpt-4o-mini
# Base URLs let a provider point at Azure OpenAI, a proxy or a gateway.
AAP_OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic-compatible provider (Messages API). Registered only when a key is
# set. AAP_ANTHROPIC_MODEL is the model id used for it.
AAP_ANTHROPIC_API_KEY=
AAP_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AAP_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Local / offline (Ollama, vLLM, llama.cpp OpenAI-compatible server):
AAP_LOCAL_MODEL_BASE_URL=
AAP_LOCAL_MODEL_NAME=qwen2.5:7b
# File-backed GGUF model (llama.cpp). Must live under AAP_LOCAL_MODEL_STORAGE_DIR.
# Run the engine in a child process so a native abort cannot crash the agent.
AAP_LOCAL_MODEL_PATH=
AAP_LOCAL_MODEL_STORAGE_DIR=
AAP_LOCAL_MODEL_ISOLATE=true
# Deadline for a single local inference call, in seconds. CPU-only inference of
# a planning + tool-schema prompt can take minutes; keep this below
# AAP_MAX_RUN_SECONDS so slow inference is not reported as a run failure.
AAP_LOCAL_MODEL_TIMEOUT_SECONDS=300

# --- Storage ---
AAP_DATABASE_URL=
# Redis: distributed rate limiting, locking, idempotency and the job queue.
# Leave empty for the local/offline runtime (in-memory coordination).
AAP_REDIS_URL=
AAP_LOCAL_STORE_DIR=.agent-data

# --- Execution ---
# inline: the API runs the agent in-process (local/offline).
# queued: the API persists + enqueues, a worker executes (production).
AAP_EXECUTION_MODE=inline
AAP_WORKER_ID=
AAP_WORKER_POLL_SECONDS=1
AAP_WORKER_LEASE_SECONDS=120
AAP_WORKER_HEARTBEAT_SECONDS=20
AAP_JOB_MAX_ATTEMPTS=3
AAP_RECOVERY_INTERVAL_SECONDS=15

# --- Agent guard rails ---
AAP_MAX_STEPS_PER_RUN=40
AAP_MAX_TOOL_RETRIES=3
AAP_MAX_REPLANS=3
AAP_MAX_RUN_SECONDS=600
AAP_MAX_CONTEXT_TOKENS=16000

# --- Security ---
AAP_REQUIRE_AUTH=true
AAP_RATE_LIMIT_PER_MINUTE=120
AAP_APPROVAL_TTL_SECONDS=3600
# JSON map of API key -> principal. Example:
# AAP_API_KEYS={"k_dev_123":{"tenant_id":"tnt_demo","user_id":"usr_admin","roles":["admin"]}}
AAP_API_KEYS=

# --- Local / desktop runtime (AAP_RUNTIME_KIND=local) ---
# Declared operating mode; never inferred from a failed request.
AAP_LOCAL_MODE=offline
# Extra roots the local tools may touch (comma-separated). The run workspace is
# always allowed; sensitive locations (/etc, ~/.ssh, ~/.aws, *.pem, ...) are
# always refused. Leave empty for workspace-only.
AAP_LOCAL_WORKSPACE_ROOTS=
AAP_LOCAL_DENIED_ROOTS=
# Network access for local tools: disabled (default) | allowlist | enabled.
AAP_LOCAL_NETWORK_POLICY=disabled
AAP_LOCAL_NETWORK_ALLOWLIST=
# Commands the controlled runner may execute, by basename (comma-separated).
# Empty means no command may run.
AAP_LOCAL_COMMAND_ALLOWLIST=
# Permit confidential (not secret) data to be processed remotely. Secret data
# never crosses the boundary, regardless of this flag.
AAP_LOCAL_ALLOW_CONFIDENTIAL_REMOTE=false
AAP_LOCAL_DEVICE_LABEL=this-device
# Local control API for the desktop UI. Binds to loopback by default.
AAP_LOCAL_CONTROL_ENABLED=false
AAP_LOCAL_CONTROL_HOST=127.0.0.1
AAP_LOCAL_CONTROL_PORT=8765
# Shared secret for the control API. Required when the control API is enabled
# with auth on; leave empty to disable the surface. NEVER commit a value.
AAP_LOCAL_CONTROL_TOKEN=

# --- Observability ---
# Structured JSON logs with correlation ids (request/run/job/tenant/user).
# Set to false for a human-readable local console.
AAP_LOG_JSON=true
AAP_LOG_LEVEL=INFO
# Prometheus metrics at GET /metrics.
AAP_METRICS_ENABLED=true
# Optional OpenTelemetry export (only used when the SDK is installed).
AAP_OTEL_ENABLED=false
AAP_OTEL_SERVICE_NAME=arabic-agent
# Timeout for each dependency probe behind GET /readyz.
AAP_READINESS_TIMEOUT_SECONDS=2

# --- Document generation (optional 'docgen' extra) ---
# Arabic PDF output needs a Unicode font that covers Arabic. The generator
# searches common OS font paths; set this to pin a specific .ttf. Latin-only
# PDFs work without it.
AAP_DOCGEN_FONT=
